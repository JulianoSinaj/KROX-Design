# Opsionale: endpoint për formularin e kontaktit (POST JSON), p.sh. Formspree.
# Krijoni një formë falas te https://formspree.io me email-in e kompanisë, pastaj
# kopjoni këtë skedar si .env dhe vendosni linkun:
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Pa këtë variabël, formulari hap aplikacionin e email-it të vizitorit
# me mesazhin të parambushur drejt valeronshpk@gmail.com.
VITE_CONTACT_ENDPOINT=
